{
  "name": "books",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c development",
    "build": "ng build -c production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --coverage-reporters text --coverage-reporters html",
    "lint": "ng lint",
    "e2e": "bddgen && playwright test",
    "e2e:ui": "bddgen && playwright test --ui",
    "e2e:gen": "bddgen",
    "e2e:report": "playwright show-report",
    "db:mock": "json-server ./src/data/db.json -w -d 100 -i isbn",
    "analyze": "ng build -c production --stats-json && esbuild-visualizer --metadata dist/books/browser-stats.json --filename dist/bundle-report.html --open",
    "docs": "compodoc -p tsconfig.doc.json -d documentation",
    "docs:serve": "compodoc -p tsconfig.doc.json -d documentation -s"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "json-server": "^0.17.4",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.5"
  }
}
